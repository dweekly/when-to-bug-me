#!/bin/sh
# Pre-push check: refuse the push if the secret and private-data scan or the unit tests fail.
# Enabled per clone by scripts/install-hooks.sh (git config core.hooksPath hooks).
set -eu

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

echo "pre-push: scanning the tree and the history for secrets and private data"
# History too: a secret committed and then deleted is still in the commits being pushed.
if ! python3 scripts/scan.py || ! python3 scripts/scan.py --history; then
  echo "pre-push: scan failed; push refused" >&2
  exit 1
fi

if [ -d node_modules ]; then
  echo "pre-push: running unit tests"
  if ! npm test --silent; then
    echo "pre-push: tests failed; push refused" >&2
    exit 1
  fi
else
  echo "pre-push: node_modules missing, skipping unit tests (run npm ci to enable them)"
fi
